{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "$id": "@jsse/tsconfig/cjs",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleDetection": "auto",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "${configDir}/dist/cjs",
    "verbatimModuleSyntax": null
  }
}
