{
  "name": "@jsse/tsconfig",
  "version": "0.5.2",
  "description": "tsconfig",
  "keywords": [
    "config",
    "jawascript",
    "tsconfig",
    "typescript"
  ],
  "license": "MIT",
  "author": "jessekrubin <jessekrubin@gmail.com>",
  "files": [
    "README.md",
    "dist",
    "license",
    "package.json",
    "tsconfig.bundler.json",
    "tsconfig.json",
    "tsconfig.schema.json",
    "tsconfig.strict.json"
  ],
  "type": "module",
  "exports": {
    ".": "./tsconfig.json",
    "./lib": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./package.json": "./package.json",
    "./tsconfig.json": "./tsconfig.json",
    "./tsconfig.strict.json": "./tsconfig.strict.json",
    "./strict": "./tsconfig.strict.json",
    "./strict.json": "./tsconfig.strict.json",
    "./schema": "./tsconfig.schema.json",
    "./schema.json": "./tsconfig.schema.json",
    "./tsconfig.bundler.json": "./tsconfig.bundler.json",
    "./bundler": "./tsconfig.bundler.json",
    "./bundler.json": "./tsconfig.bundler.json",
    "./tsconfig.schema.json": "./tsconfig.schema.json"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run gen && pnpm run test && publint",
    "build:lib": "tsdown",
    "gen": "tsx scripts/update-pkg-json-exports.ts",
    "check": "eslint . && prettier --check --object-wrap=collapse .",
    "fmt": "prettier --write --object-wrap=collapse .",
    "fmtc": "prettier --check --object-wrap=collapse .",
    "lint": "eslint .",
    "test": "node --test ./tests/jsse-tsconfig.test.ts && pnpm run typecheck",
    "tsc": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig._build.json"
  },
  "devDependencies": {
    "@jsse/eslint-config": "^0.9.16",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "oxfmt": "^0.62.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
