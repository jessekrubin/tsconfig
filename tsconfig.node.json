{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "$id": "@jsse/tsconfig/node",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["esnext"],
    "module": "nodenext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}
